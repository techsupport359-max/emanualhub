# Supabase project settings (PostgreSQL + Auth + private Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Add these only after creating provider accounts. Never expose secret keys in NEXT_PUBLIC_ variables.
# PayPal Sandbox (switch to https://api-m.paypal.com only after production readiness review)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Email delivery (Resend); use a verified sender/domain
RESEND_API_KEY=
MANUALS_FROM_EMAIL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep personal WhatsApp number out of public client variables.
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_VERIFY_TOKEN=
SUPPORT_EMAIL=emanualshub@gmail.com
ADMIN_EMAIL=
# Required to access /admin/manual-requests; use a long random secret
ADMIN_ACTION_TOKEN=

# Optional ticket email notification (Resend)
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
# Public support contact options. WhatsApp number must include country code, digits only (e.g. 15551234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=19412873109
NEXT_PUBLIC_SUPPORT_EMAIL=emanualshub@gmail.com

